# Airwallex — server only. Never expose these to the browser.
AIRWALLEX_ENV=sandbox                     # sandbox | production
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_API_VERSION=2026-08-21
AIRWALLEX_WEBHOOK_SECRET=                 # optional; poll still works without it

# App
MONGODB_URI=mongodb://localhost:27017/globalpayout?replicaSet=rs0&directConnection=true
SOURCE_CURRENCY=USD                       # wallet currency that funds every row
DEMO_MODE=true
NEXT_PUBLIC_DATA_SOURCE=mock              # mock | api
PAYMENTS_GATEWAY=mock                     # mock | airwallex
