        "pattern": "AED|ALL|AMD|AOA|ARS|AUD|AZN|BAM|BBD|BDT|BHD|BOB|BRL|BSD|BWP|BZD|CAD|CHF|CLP|CNY|COP|CRC|CZK|DKK|DOP|DZD|EGP|EUR|FJD|GBP|GEL|GHS|GMD|GTQ|GYD|HKD|HNL|HUF|IDR|ILS|INR|ISK|JMD|JOD|JPY|KES|KGS|KRW|KWD|KZT|LKR|LSL|MAD|MGA|MUR|MWK|MXN|MYR|NAD|NGN|NIO|NOK|NPR|NZD|OMR|PEN|PHP|PKR|PLN|PYG|QAR|RON|RSD|RWF|SAR|SCR|SEK|SGD|THB|TND|TRY|TTD|TZS|USD|UYU|VND|XAF|XOF|ZAR|ZMW"
      }
    },
    {
      "key": "transfer_method",
      "path": "transfer_method",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "LOCAL|SWIFT"
      }
    },
    {
      "key": "local_clearing_system",
      "path": "beneficiary.bank_details.local_clearing_system",
      "required": false,
      "rule": {
        "type": "string",
        "pattern": "FAST|GIRO|RTGS"
      }
    },
    {
      "key": "first_name",
      "path": "beneficiary.first_name",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "^[\\s\\S]{1,100}$"
      }
    },
    {
      "key": "last_name",
      "path": "beneficiary.last_name",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "^[\\s\\S]{1,100}$"
      }
    },
    {
      "key": "date_of_birth",
      "path": "beneficiary.date_of_birth",
      "required": false,
      "rule": {
        "type": "string",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    {
      "key": "swift_code",
      "path": "beneficiary.bank_details.swift_code",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "^[A-Z]{4}SG[A-Z0-9]{2}([A-Z0-9]{3})?$"
      }
    },
    {
      "key": "account_number",
      "path": "beneficiary.bank_details.account_number",
      "required": true,
      "rule": {
        "pattern": "^[0-9A-Za-z]{7,17}$",
        "type": "string"
      }
    },
    {
      "key": "account_name",
      "path": "beneficiary.bank_details.account_name",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "^(?!\\d+$)[\\s\\S]{2,200}$"
      }
    },
    {
      "key": "country_code",
      "path": "beneficiary.address.country_code",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "AD|AE|AF|AG|AI|AL|AM|AN|AO|AQ|AR|AS|AT|AU|AW|AX|AZ|BA|BB|BD|BE|BF|BG|BH|BI|BJ|BL|BM|BN|BO|BQ|BR|BS|BT|BV|BW|BZ|CA|CC|CD|CF|CG|CH|CI|CK|CL|CM|CN|CO|CR|CV|CW|CX|CY|CZ|DE|DJ|DK|DM|DO|DZ|EC|EE|EG|EH|ER|ES|ET|FI|FJ|FK|FM|FO|FR|GA|GB|GD|GE|GF|GG|GH|GI|GL|GM|GN|GP|GQ|GR|GS|GT|GU|GW|GY|HK|HM|HN|HR|HT|HU|IC|ID|IE|IL|IM|IN|IO|IQ|IS|IT|JE|JM|JO|JP|KE|KG|KH|KI|KM|KN|KR|KW|KY|KZ|LA|LB|LC|LI|LK|LR|LS|LT|LU|LV|MA|MC|MD|ME|MF|MG|MH|MK|ML|MN|MO|MP|MQ|MR|MS|MT|MU|MV|MW|MX|MY|MZ|NA|NC|NE|NF|NG|NI|NL|NO|NP|NR|NU|NZ|OM|PA|PE|PF|PG|PH|PK|PL|PM|PN|PR|PS|PT|PW|PY|QA|RE|RO|RS|RW|SA|SB|SC|SD|SE|SG|SH|SI|SJ|SK|SL|SM|SN|SO|SR|SS|ST|SV|SX|SZ|TC|TD|TF|TG|TH|TJ|TK|TL|TM|TN|TO|TR|TT|TV|TW|TZ|UA|UG|UM|US|UY|UZ|VA|VC|VG|VI|VN|VU|WF|WS|XK|YE|YT|ZA|ZM|ZW"
      }
    },
    {
      "key": "postcode",
      "path": "beneficiary.address.postcode",
      "required": true,
      "rule": {
        "pattern": "^\\d{6}$",
        "type": "string"
      }
    },
    {
      "key": "street_address",
      "path": "beneficiary.address.street_address",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "(^(?!\\d+$))^[\\s\\S]{5,200}$"
      }
    },
    {
      "key": "city",
      "path": "beneficiary.address.city",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "^[\\s\\S]{1,50}$"
      }
    },
    {
      "key": "nickname",
      "path": "nickname",
      "required": false
    },
    {
      "key": "personal_email",
      "path": "beneficiary.additional_info.personal_email",
      "required": false,
      "rule": {
        "type": "string",
        "pattern": "^(\\S+@\\S+)$"
      }
    },
    {
      "key": "type",
      "path": "beneficiary.type",
      "required": true,
      "rule": {
        "type": "string",
        "pattern": "BANK_ACCOUNT|DIGITAL_WALLET|CRYPTO_WALLET"
      }
    }
  ],
  "key": "newRecipient"
}
