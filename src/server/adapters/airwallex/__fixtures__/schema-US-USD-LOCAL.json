      "required": true,
      "rule": {
        "type": "string",
        "pattern": "AED|ALL|AMD|AOA|ARS|AUD|AZN|BAM|BBD|BDT|BHD|BOB|BRL|BSD|BWP|BZD|CAD|CHF|CLP|CNY|COP|CRC|CZK|DKK|DOP|DZD|EGP|EUR|FJD|GBP|GEL|GHS|GMD|GTQ|GYD|HKD|HNL|HUF|IDR|ILS|INR|ISK|JMD|JOD|JPY|KES|KGS|KRW|KWD|KZT|LKR|LSL|MAD|MGA|MUR|MWK|MXN|MYR|NAD|NGN|NIO|NOK|NPR|NZD|OMR|PEN|PHP|PKR|PLN|PYG|QAR|RON|RSD|RWF|SAR|SCR|SEK|SGD|THB|TND|TRY|TTD|TZS|USD|UYU|VND|XAF|XOF|ZAR|ZMW"
